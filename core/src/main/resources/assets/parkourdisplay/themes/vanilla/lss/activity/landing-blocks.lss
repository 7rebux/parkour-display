.activity-title {
  left: 50%;
  top: 12;
  alignment-x: center;
}

.empty {
  left: 50%;
  top: 50%;
  alignment-x: center;
  alignment-y: center;
}

Scroll {
  left: 50%;
  top: 30;
  bottom: 10;
  width: 360;
  alignment-x: center;

  .landing-block-list {
    width: 100%;
    height: fit-content;
    space-between-entries: 2;
  }

  .landing-block-entry {
    width: 100%;
    height: 20;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 4;
    padding-right: 2;
    orientation: horizontal;
    space-between-entries: 2;
    background-color: rgba(0, 0, 0, 100);

    &:hover {
      background-color: rgba(0, 0, 0, 160);
    }

    .column {
      top: 50%;
      alignment-y: center;
      max-lines: 1;
    }

    .mode {
      width: 50;
      height: 16;
    }

    .position {
      width: 120;
    }

    .reset-button {
      width: 40;
      height: 16;
    }

    .remove-button {
      width: 16;
      height: 16;
    }
  }

  Scrollbar {
    width: 5;
    margin-left: 2;
  }
}
